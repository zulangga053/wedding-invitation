# API Environment (development)
NODE_ENV=development
PORT=3001

# Browser origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000

# Optional Redis for distributed rate limiting (Upstash / Redis URL)
REDIS_URL=

# Firebase Admin SDK — REQUIRED for production/Cloud Run.
# In local dev against the emulator, only FIREBASE_PROJECT_ID is needed
# (emulator hosts are picked up from FIRESTORE_EMULATOR_HOST etc.).
FIREBASE_PROJECT_ID=demo-momentia
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set by `firebase emulators:exec` automatically:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199