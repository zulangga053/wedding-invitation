rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read-only media (validated & uploaded via Admin API).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Private tenant media — only served through server-generated signed URLs.
    match /private/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}